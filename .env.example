# ─────────────────────────────────────────────────────────────
# Spotlyn Cleaning — environment variables
# Copy to `.env` (prod/docker) or `.env.local` (dev) and fill in.
# NEVER commit the real .env (it is gitignored).
# ─────────────────────────────────────────────────────────────

# ── App (Next.js) ──
# Public site URL. Baked into the client bundle at BUILD time, so it must also
# be passed to the image build as --build-arg NEXT_PUBLIC_SITE_URL=...
NEXT_PUBLIC_SITE_URL=https://wylcleaning.com

# ── Quote & "Join Our Team" form delivery (Google Workspace SMTP) ──
# Without SMTP_USER/SMTP_PASS the forms run in "log mode" (no email is sent).
# The Workspace mailbox that sends the mail:
SMTP_USER=info@wylcleaning.com
# A Google "App Password" (16 chars) for that mailbox — NOT the login password.
# Google Account → Security → 2-Step Verification → App passwords.
SMTP_PASS=
# Optional: defaults to smtp.gmail.com / 465 (SSL). Use 587 for STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Display sender (defaults to SMTP_USER). Must be that Workspace address/alias.
EMAIL_FROM=Wyl Cleaning <info@wylcleaning.com>
# Inbox that receives quote & application leads.
EMAIL_TO=info@wylcleaning.com

# ── Production image (used by docker-compose.prod.yml) ──
# Replace OWNER with your GitHub username/org (lowercase).
WEB_IMAGE=ghcr.io/OWNER/weylin-cleaning-services:latest
